# Server
PORT=3000
NODE_ENV=development

# OpenAI — required for AI-powered suggestions endpoints
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS — comma-separated list of allowed origins; no wildcard (*) is supported.
# Leave empty to allow only localhost (development) or nothing (production).
CORS_ORIGIN=http://localhost:3000,https://your-app.example.com
