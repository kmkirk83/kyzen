# Core application
NODE_ENV=development
APP_URL=http://localhost:3000

# Data
DATABASE_URL=******HOST:5432/clarion?schema=public

# Authentication
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Telegram copilot connector
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_COPILOT_SYSTEM_PROMPT=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=

# Outbound API access
CLARION_API_BASE_URL=http://localhost:3000/api
